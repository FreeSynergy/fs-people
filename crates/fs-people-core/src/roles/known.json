      "owner": "fs-crm",
      "scope": "group"
    },
    {
      "id": "prospect",
      "type": "skos:Concept",
      "names": {"en": "Prospect", "de": "Interessent"},
      "description": {"en": "Someone who has shown interest in what a group or organisation offers. No standard exists: a gap. Not a stage of customer."},
      "owner": "fs-crm",
      "scope": "group"
    }

  "id": "",
  "type": "skos:ConceptScheme",
  "names": {"en": "FreeSynergy roles", "de": "FreeSynergy-Rollen"},
  "roles": [
    {
      "id": "ai",
      "type": "skos:Concept",
      "names": {"en": "AI", "de": "KI"},
      "description": {"en": "A marked participant: everyone can see that this is not a human. Nothing else follows from it (ADR 0054)."},
      "standard": "JSContact kind application (RFC 9553, section 2.1.4)",
      "owner": "fs-people",
      "scope": "public",
      "cardKind": "application"
    },
    {
      "id": "user",
      "type": "org:Role",
      "names": {"en": "User", "de": "Benutzer"},
      "description": {"en": "Someone who can sign in to a system."},
      "standard": "SCIM User (RFC 7643)",
      "owner": "fs-identity",
      "scope": "group"
    },
    {
      "id": "member",
      "type": "org:Role",
      "names": {"en": "Member", "de": "Mitglied"},
      "description": {"en": "Someone who belongs to a group."},
      "standard": "org:Membership, AS2 Group, SCIM Group",
      "owner": "fs-groups",
      "scope": "group"
    },
    {
      "id": "customer",
      "type": "skos:Concept",
      "names": {"en": "Customer", "de": "Kunde"},
